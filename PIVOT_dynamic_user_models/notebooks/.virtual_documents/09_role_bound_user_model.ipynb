            "candidates": ["brief", "detailed"],
            "expected": repair_expected[name],
        }
    )

for item in repair_plan:
    print(
        item["condition"],
        "| candidates:", item["candidates"],
        "| expected:", item["expected"],
    )


# ------------------------------------------------------------
# Render and tokenize Retrieval Repair v0.1
# ------------------------------------------------------------

for item in repair_plan:
    rendered = render_messages(
        processor,
        item["messages"],
    )

    token_ids = tokenizer.encode(
        rendered,
        add_special_tokens=False,
    )

    item["rendered_prompt"] = rendered
    item["token_ids"] = token_ids

for item in repair_plan:
    print(
        item["condition"],
        "| expected:", item["expected"],
        "| n_messages:", len(item["messages"]),
        "| n_tokens:", len(item["token_ids"]),
        "| tail:",
        tokenizer.convert_ids_to_tokens(item["token_ids"][-3:]),
    )


for item in repair_plan:
    item["prompt_sha256"] = hashlib.sha256(
        item["rendered_prompt"].encode("utf-8")
    ).hexdigest()


repair_manifest = {
    "schema_version": "notebook09_retrieval_repair_v0.1",
    "parent_experiment_manifest_sha256": manifest_sha256,

    "rationale": (
        "Original composed A-B/A-A/B-A/B-B retrieval check failed. "
        "Token-level diagnosis showed strong output-format preference toward A. "
        "This single preregistered repair replaces the artificial composed code "
        "with direct single-token preference-value retrieval. "
        "Behavioral results remain unopened."
    ),

    "candidates": ["brief", "detailed"],

    "decision_rule": {
        "metric": (
            "logP(correct preference value) "
            "- logP(incorrect preference value)"
        ),
        "threshold": 2.0,
        "requirement": "all_four_conditions_must_pass",
        "failure_action": (
            "terminate Notebook 09 role-bound-user pivot "
            "without inspecting behavioral results"
        ),
    },

    "run_order": [
        item["condition"]
        for item in repair_plan
    ],

    "conditions": [
        {
            "condition": item["condition"],
            "expected": item["expected"],
            "candidates": item["candidates"],
            "messages": item["messages"],
            "rendered_prompt": item["rendered_prompt"],
            "token_ids": item["token_ids"],
            "prompt_sha256": item["prompt_sha256"],
        }
        for item in repair_plan
    ],
}


repair_manifest_json = json.dumps(
    repair_manifest,
    sort_keys=True,
    separators=(",", ":"),
    ensure_ascii=False,
)

repair_manifest_sha256 = hashlib.sha256(
    repair_manifest_json.encode("utf-8")
).hexdigest()


for item in repair_plan:
    print(
        item["condition"],
        "| prompt_sha256:",
        item["prompt_sha256"],
    )

print()
print(
    "Retrieval Repair v0.1 manifest SHA256:",
    repair_manifest_sha256,
)


# ------------------------------------------------------------
# Raw scorer for Retrieval Repair v0.1
# ------------------------------------------------------------

BRIEF_ID = 37767
DETAILED_ID = 135615

def score_retrieval_repair_raw(model, item):

    input_ids = torch.tensor(
        [item["token_ids"]],
        dtype=torch.long,
        device="cuda",
    )
    attention_mask = torch.ones_like(input_ids)

    with torch.inference_mode():
        outputs = model(
            input_ids=input_ids,
            attention_mask=attention_mask,
            use_cache=False,
        )

    final_logits = outputs.logits[0, -1, :].float()
    log_z = torch.logsumexp(final_logits, dim=-1)

    brief_logit = final_logits[BRIEF_ID]
    detailed_logit = final_logits[DETAILED_ID]

    brief_logprob = brief_logit - log_z
    detailed_logprob = detailed_logit - log_z

    return {
        "condition": item["condition"],
        "prompt_sha256": item["prompt_sha256"],
        "expected": item["expected"],

        "brief_token_id": BRIEF_ID,
        "detailed_token_id": DETAILED_ID,

        "brief_logit": brief_logit.item(),
        "detailed_logit": detailed_logit.item(),

        "log_normalizer": log_z.item(),

        "brief_logprob": brief_logprob.item(),
        "detailed_logprob": detailed_logprob.item(),
    }


# ------------------------------------------------------------
# Execute frozen Retrieval Repair v0.1
# RAW RESULTS ONLY
# ------------------------------------------------------------

repair_raw_results = []

for run_index, item in enumerate(repair_plan, start=1):

    result = score_retrieval_repair_raw(
        model=model,
        item=item,
    )

    result["run_index"] = run_index
    result["repair_manifest_sha256"] = repair_manifest_sha256

    repair_raw_results.append(result)

    print(
        f"{run_index}/4 "
        f"| {item['condition']}"
    )


repair_results_path = (
    results_dir
    / f"retrieval_repair_v01__{repair_manifest_sha256[:12]}.json"
)

if repair_results_path.exists():
    raise FileExistsError(
        f"Refusing to overwrite existing repair results: "
        f"{repair_results_path}"
    )

repair_payload = {
    "repair_manifest_sha256": repair_manifest_sha256,
    "parent_experiment_manifest_sha256": manifest_sha256,
    "results": repair_raw_results,
}

repair_results_path.write_text(
    json.dumps(
        repair_payload,
        indent=2,
        ensure_ascii=False,
    ),
    encoding="utf-8",
)

print()
print("Saved:", repair_results_path)
print("Result records:", len(repair_raw_results))


# ------------------------------------------------------------
# Reload Retrieval Repair v0.1 results from disk
# ------------------------------------------------------------

repair_payload_loaded = json.loads(
    repair_results_path.read_text(encoding="utf-8")
)

assert (
    repair_payload_loaded["repair_manifest_sha256"]
    == repair_manifest_sha256
)

assert (
    repair_payload_loaded["parent_experiment_manifest_sha256"]
    == manifest_sha256
)

repair_loaded_results = repair_payload_loaded["results"]

assert len(repair_loaded_results) == 4

print("Repair manifest verified:", repair_payload_loaded["repair_manifest_sha256"])
print("Parent manifest verified:", repair_payload_loaded["parent_experiment_manifest_sha256"])
print("Result records:", len(repair_loaded_results))


# ------------------------------------------------------------
# Apply frozen Retrieval Repair v0.1 decision rule
# ------------------------------------------------------------

repair_analysis = {}

for result in repair_loaded_results:

    expected = result["expected"]

    if expected == "brief":
        correct_logprob = result["brief_logprob"]
        incorrect_logprob = result["detailed_logprob"]

    elif expected == "detailed":
        correct_logprob = result["detailed_logprob"]
        incorrect_logprob = result["brief_logprob"]

    else:
        raise ValueError(
            f"Unexpected expected label: {expected}"
        )

    margin = correct_logprob - incorrect_logprob
    passes = margin >= 2.0

    repair_analysis[result["condition"]] = {
        "expected": expected,
        "brief_logprob": result["brief_logprob"],
        "detailed_logprob": result["detailed_logprob"],
        "margin": margin,
        "passes": passes,
    }

    print(f"\n{result['condition']}")
    print(f"Expected: {expected}")
    print(f"logP(brief):    {result['brief_logprob']:.6f}")
    print(f"logP(detailed): {result['detailed_logprob']:.6f}")
    print(f"M_retrieve: {margin:.6f}")
    print(f"Pass >= 2.0: {passes}")


all_repair_pass = all(
    result["passes"]
    for result in repair_analysis.values()
)

print()
print("ALL FOUR PASS:", all_repair_pass)



