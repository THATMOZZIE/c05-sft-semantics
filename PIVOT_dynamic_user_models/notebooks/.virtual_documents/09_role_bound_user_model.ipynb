# ------------------------------------------------------------

retrieval_analysis = {}

for result in loaded_results:
    if result["task"] != "retrieval":
        continue

    condition = result["condition"]
    expected = result["expected"]

    candidate_logprobs = {
        candidate: score["total_logprob"]
        for candidate, score in result["candidate_scores"].items()
    }

    correct_logprob = candidate_logprobs[expected]

    wrong_logprobs = {
        candidate: logprob
        for candidate, logprob in candidate_logprobs.items()
        if candidate != expected
    }

    best_wrong_candidate = max(
        wrong_logprobs,
        key=wrong_logprobs.get,
    )

    best_wrong_logprob = wrong_logprobs[best_wrong_candidate]

    margin = correct_logprob - best_wrong_logprob

    retrieval_analysis[condition] = {
        "expected": expected,
        "candidate_logprobs": candidate_logprobs,
        "best_wrong": best_wrong_candidate,
        "margin": margin,
        "passes": margin >= 2.0,
    }

    print(f"\n{condition}")
    print(f"Expected: {expected}")

    for candidate, logprob in candidate_logprobs.items():
        print(f"  {candidate}: {logprob:.6f}")

    print(f"Best wrong: {best_wrong_candidate}")
    print(f"M_correct: {margin:.6f}")
    print(f"Pass >= 2.0: {margin >= 2.0}")





