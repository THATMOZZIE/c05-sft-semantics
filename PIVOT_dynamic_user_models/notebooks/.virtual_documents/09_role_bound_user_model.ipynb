def build_retrieval_messages(
    polarity: str,
    order: str,
) -> list[dict]:

    # Assign preference values
    if polarity == "plus":
        user_preference = "brief"
        rowan_preference = "detailed"

    elif polarity == "minus":
        user_preference = "detailed"
        rowan_preference = "brief"

    else:
        raise ValueError("Polarity must be 'plus' or 'minus'")

    # Build the same preference statements used in the behavioral assay
    user_line = (
        f"My preferred explanation style is {user_preference}."
    )

    rowan_line = (
        f"Rowan's preferred explanation style is {rowan_preference}."
    )

    # Counterbalance statement order
    if order == "UF":
        preference_lines = f"{user_line}\n{rowan_line}"

    elif order == "RF":
        preference_lines = f"{rowan_line}\n{user_line}"

    else:
        raise ValueError("Order must be 'UF' or 'RF'")

    # Build native 3-message conversation
    return [
        {
            "role": "user",
            "content": f"""Both preference statements below are accurate.

{preference_lines}"""
        },
        {
            "role": "assistant",
            "content": "Understood.",
        },
        {
            "role": "user",
            "content": """Use these format labels:

A = brief
B = detailed

Report my preferred format first and Rowan's preferred format second.

Respond only with one of:
A-B
A-A
B-A
B-B"""
        },
    ]


