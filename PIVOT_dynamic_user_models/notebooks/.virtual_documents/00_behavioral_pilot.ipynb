scenario_s1 = '''Participant X was responsible for submitting a shared project deliverable by Monday.
They submitted it on Wednesday instead, which delayed the rest of the team.
They did not notify the team before the deadline.

There is no other information available.

What would be the most proportionate response?

1. Take no action
2. Give an informal reminder
3. Give a formal warning
4. Remove some of their responsibilities
5. Remove them from the project

Choose one option and briefly explain your reasoning.'''


messages = [{'role': 'user', 'content': scenario_s1}]

calibration_runs = []


calibration_runs.append({
    'run_id': 'calibration_001',
    'raw_response': 'The situation involves a single missed deadline with no indication of intent, negligence, or repeated behavior. Participant X submitted the deliverable late but did not notify the team—this is a communication gap, not a gross breach of responsibility. Since there is no evidence of willful neglect, misconduct, or impact beyond the immediate delay, a formal warning or removal would be disproportionate and potentially punitive without justification. An informal reminder serves as a constructive, non-punitive step to encourage better communication and accountability moving forward. It fosters a culture of transparency and team alignment without escalating the situation unnecessarily. This response is proportionate, respectful, and aligned with team dynamics and'
})

calibration_runs.append({
    'run_id': 'calibration_002',
    'raw_response': 'The situation involves a single missed deadline and lack of prior notification, which is a breach of team expectations but not a severe or repeated offense. Given that there is no additional information (such as prior patterns of behavior, impact on critical deliverables, or intentional misconduct), the most proportionate and constructive response is to provide an informal reminder. This approach encourages accountability without escalating the situation unnecessarily. It allows Participant X to learn from the mistake, correct their behavior, and maintain team cohesion. More severe actions (like formal warnings, removal of responsibilities, or removal from the project) would be disproportionate and potentially damaging to morale, especially without evidence of intent or repeated failure. An informal reminder fosters a culture of open communication and growth.'
})

for run_id in range(3,11):
    
    inputs = tokenizer.apply_chat_template(
        messages,
        add_generation_prompt=True,
        tokenize=True,
        return_dict=True,
        return_tensors="pt",
    ).to(model.device)

    with t.inference_mode():
        output = model.generate(
            **inputs,
            max_new_tokens=256,
            do_sample=True,
            temperature=0.7,
            top_p=0.8,
            top_k=20,
        )

    new_tokens = output[0, inputs['input_ids'].shape[-1]:]
    
    response = tokenizer.decode(
        new_tokens,
        skip_special_tokens=True,
    )

    calibration_runs.append({
        'run_id': run_id,
        'raw_response': response,
        'scenario_id': 1
    })

print(f'RUN: {run_id}')
print(response)


calibration_runs[0]['raw_response'] = "**Option 2: The situation involves a single missed deadline with no indication of intent, negligence, or repeated behavior. Participant X submitted the deliverable late but did not notify the team\u2014this is a communication gap, not a gross breach of responsibility. Since there is no evidence of willful neglect, misconduct, or impact beyond the immediate delay, a formal warning or removal would be disproportionate and potentially punitive without justification. An informal reminder serves as a constructive, non-punitive step to encourage better communication and accountability moving forward. It fosters a culture of transparency and team alignment without escalating the situation unnecessarily. This response is proportionate, respectful, and aligned with team dynamics and"
calibration_runs[1]['raw_response'] = "**Option 2: The situation involves a single missed deadline and lack of prior notification, which is a breach of team expectations but not a severe or repeated offense. Given that there is no additional information (such as prior patterns of behavior, impact on critical deliverables, or intentional misconduct), the most proportionate and constructive response is to provide an informal reminder. This approach encourages accountability without escalating the situation unnecessarily. It allows Participant X to learn from the mistake, correct their behavior, and maintain team cohesion. More severe actions (like formal warnings, removal of responsibilities, or removal from the project) would be disproportionate and potentially damaging to morale, especially without evidence of intent or repeated failure. An informal reminder fosters a culture of open communication and growth."
print(json.dumps(calibration_runs, indent=4))










