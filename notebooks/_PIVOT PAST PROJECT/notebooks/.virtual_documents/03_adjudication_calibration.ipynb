def inspect_first_token_logprobs(
    messages: list[dict],
    seed: int,
    n_probs: int = 50,
) -> dict:

    payload = {
        "messages": messages,
        **GENERATION_CONFIG,
        "max_tokens": 1,
        "n_probs": n_probs,
        "seed": seed,
    }

    response = requests.post(
        SERVER_URL,
        json=payload,
        timeout=300,
    )

    if not response.ok:
        raise RuntimeError(
            f"HTTP {response.status_code}\n"
            f"{response.text}"
        )

    return response.json()


